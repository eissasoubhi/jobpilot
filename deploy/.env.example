# Immutable container version produced from main. deploy.sh replaces this value.
JOBPILOT_VERSION=0000000000000000000000000000000000000000

# Local staging: http://jobpilot.staging.local
# Production: jobpilot.example.com (Caddy will obtain HTTPS automatically).
CADDY_SITE_ADDRESS=http://jobpilot.staging.local
HTTP_PORT=80
HTTPS_PORT=443

APP_SECRET=change-me
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
WEB_URL=http://jobpilot.staging.local
DEFAULT_URI=http://jobpilot.staging.local

POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
# Prefer a URL-safe value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://jobpilot.staging.local/api/integrations/gmail/callback
GMAIL_SEARCH_QUERY=(job OR emploi OR offre OR mission OR candidature OR application OR recruiter OR entretien) newer_than:30d
GMAIL_MAX_RESULTS=100
GMAIL_MAX_PAGES=3

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr
ADZUNA_WHERE=
ADZUNA_RESULTS_PER_QUERY=20

FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_TOKEN_ENDPOINT=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FRANCE_TRAVAIL_SEARCH_ENDPOINT=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search
FRANCE_TRAVAIL_RESULTS_PER_QUERY=50

SMARTRECRUITERS_API_TOKEN=
SMARTRECRUITERS_COMPANY_IDENTIFIERS=
SMARTRECRUITERS_PAGES=1
SMARTRECRUITERS_RESULTS_PER_PAGE=100
SMARTRECRUITERS_MAX_DETAILS=20

ARBEITNOW_ENABLED=1
ARBEITNOW_PAGES=3
SYMFONY_JOBS_RSS_ENABLED=1
LE_STUDIO_TECH_ENABLED=1
LE_STUDIO_TECH_PAGES=8
LE_STUDIO_TECH_MAX_DETAILS=20
JOB_SYNC_INTERVAL_SECONDS=21600
SCHEDULER_HEARTBEAT_GRACE_SECONDS=300

# Browser renderer shared secret; at least 24 characters.
JOBPILOT_BROWSER_WORKER_TOKEN=change-me-with-at-least-24-characters

AI_MATCHING_ENABLED=0
GEMINI_API_KEY=
GEMINI_MATCHING_MODEL=gemini-3.5-flash-lite
GEMINI_QUOTA_RPM=15
GEMINI_QUOTA_TPM=250000
GEMINI_QUOTA_RPD=500
AI_QUOTA_SAFETY_PERCENT=80

OPENAI_API_KEY=
OPENAI_MATCHING_MODEL=
MISTRAL_API_KEY=
MISTRAL_MATCHING_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MATCHING_MODEL=

CONNECTOR_ALERT_WEBHOOK_URL=
CONNECTOR_ALERT_WEBHOOK_ALLOWED_HOST=
CONNECTOR_ALERT_WEBHOOK_SECRET=
